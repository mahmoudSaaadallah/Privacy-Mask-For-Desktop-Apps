<Window x:Class="PrivacyMask.App.Windows.PanicPinUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock panic mask"
        Foreground="{StaticResource InkBrush}"
        Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
        Width="430"
        Height="380"
        MinWidth="400"
        MinHeight="290"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Unlock panic mask">
    <Border Margin="18"
            Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Text="Unlock panic mask" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,8,0,20"
                           Foreground="#51656E"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="PIN" />
                <PasswordBox x:Name="PinBox"
                             MaxLength="8"
                             Padding="10,8"
                             AutomationProperties.Name="Panic unlock PIN" />
                <TextBlock x:Name="ErrorText"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="0,12,0,0"
                           Foreground="#A33A2B"
                           TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="94"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,9"
                        IsCancel="True"
                        Content="Keep locked" />
                <Button MinWidth="100"
                        Margin="10,0,0,0"
                        Padding="14,9"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Unlock_Click"
                        Content="Unlock" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

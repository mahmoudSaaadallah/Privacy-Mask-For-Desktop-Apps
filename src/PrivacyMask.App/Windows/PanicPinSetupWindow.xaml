<Window x:Class="PrivacyMask.App.Windows.PanicPinSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure panic unlock PIN"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="390"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        Background="#F2ECE3"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Configure panic unlock PIN">
    <Border Margin="18"
            Padding="24"
            Background="#FCFAF6"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Text="Panic unlock PIN" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,8,0,20"
                           Foreground="#51656E"
                           TextWrapping="Wrap"
                           Text="Create a PIN required whenever a panic mask is disabled." />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <StackPanel x:Name="CurrentPinPanel"
                            Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="Current PIN" />
                    <PasswordBox x:Name="CurrentPinBox"
                                 MaxLength="8"
                                 Padding="10,8"
                                 AutomationProperties.Name="Current panic unlock PIN" />
                </StackPanel>

                <TextBlock Margin="0,14,0,6"
                           FontWeight="SemiBold"
                           Text="New PIN" />
                <PasswordBox x:Name="NewPinBox"
                             MaxLength="8"
                             Padding="10,8"
                             AutomationProperties.Name="New panic unlock PIN" />

                <TextBlock Margin="0,14,0,6"
                           FontWeight="SemiBold"
                           Text="Confirm new PIN" />
                <PasswordBox x:Name="ConfirmPinBox"
                             MaxLength="8"
                             Padding="10,8"
                             AutomationProperties.Name="Confirm new panic unlock PIN" />

                <TextBlock x:Name="ErrorText"
                           Margin="0,12,0,0"
                           Foreground="#A33A2B"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="94"
                        Padding="14,9"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="110"
                        Margin="10,0,0,0"
                        Padding="14,9"
                        Background="#1F6E6C"
                        BorderBrush="#1F6E6C"
                        Foreground="White"
                        IsDefault="True"
                        Click="Save_Click"
                        Content="Save PIN" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="PrivacyMask.App.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to PrivacyMask" Width="760" Height="720" MinWidth="540" MinHeight="480"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
        Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
        FontFamily="Segoe UI Variable Text" WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Welcome to PrivacyMask" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Image Source="{StaticResource PrivacyMaskLogo}" Width="64" Height="64" Margin="0,0,18,0"/>
            <StackPanel><TextBlock Text="Welcome to PrivacyMask" Style="{StaticResource PageHeading}" TextWrapping="Wrap"/><TextBlock Text="Local privacy for the desktop applications you choose." Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                    <TextBlock Text="1. Choose what to protect" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="WhatsApp and Telegram are included. Use Add application for another program, or focus it and press Ctrl + Shift + P to add it with default protection. On an existing profile, the shortcut pauses or resumes only that app." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                    <TextBlock Text="2. Tune the mask and reveal" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Adjust blur in Overview or Manage. Lower strength reveals more detail. Hover reveals a 600 × 70 pixel region by default. Hold Alt alone for 0.5 seconds to reveal the focused app; another key cancels reveal. Ctrl + Alt + Shift + ↑/↓ adjusts its blur by 5%." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                    <TextBlock Text="3. Use panic when you need full concealment" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Ctrl + Shift + H applies an opaque panic mask to the focused app. Panic mask all in Overview or the tray covers all protected apps. First use asks for a PIN; unlocking requires it. Hover and Alt never reveal panic masks." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedInkBrush}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                    <TextBlock Text="Startup preferences" FontSize="18" FontWeight="SemiBold"/>
                    <CheckBox x:Name="LaunchAtLoginCheckBox" Content="_Launch PrivacyMask when I sign in" Margin="0,14,0,12" AutomationProperties.HelpText="Starts PrivacyMask automatically for this Windows user."/>
                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Start _minimized to tray" AutomationProperties.HelpText="Hide the settings window on subsequent startup. You can reopen it from the tray."/>
                    <TextBlock Text="These choices can be changed later in Settings." Foreground="{StaticResource MutedInkBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <TextBlock Text="No injection, tracking, analytics, or cloud dependency. Live frames stay in memory. The mask is for local privacy and best-effort full-screen sharing; window-only sharing may omit it. Blur can retain detail — use solid redact or panic for complete concealment." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,8,8"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="_Use these defaults" IsDefault="True" Click="Continue_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</Window>

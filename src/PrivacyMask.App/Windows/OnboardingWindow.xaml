<Window x:Class="PrivacyMask.App.Windows.OnboardingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:PrivacyMask.App.Services"
 Title="Welcome to PrivacyMask" Width="600" Height="600" MinWidth="460" MinHeight="400"
 Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
 Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
 FontFamily="Segoe UI Variable Text" FontSize="14" WindowStartupLocation="CenterScreen"
 AutomationProperties.Name="Welcome to PrivacyMask" ResizeMode="NoResize">
 <Window.Resources>
  <Style x:Key="StepTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  <Style x:Key="StepText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="24" Background="{StaticResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Button Content="i" Style="{StaticResource CircleHelp}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Welcome privacy help" services:InformationHelp.Text="No injection, tracking, analytics, or cloud dependency. Live frames stay in memory. Window-only sharing may omit the mask. Blur can retain detail; use solid redact or panic for complete concealment. Hover reveals 600 × 70 pixels by default; hold Alt alone for 0.5 seconds to reveal only the focused app. Panic always requires your PIN to unlock."/>
   <StackPanel Margin="0,0,32,0">
    <TextBlock x:Name="StepIndicator" Text="Step 1 of 2" Style="{StaticResource StepText}"/>
    <TextBlock x:Name="HeadingText" Text="Welcome to PrivacyMask" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
    <TextBlock x:Name="SubtitleText" Text="Keep your screen private, on your terms." Style="{StaticResource StepText}" Margin="0,5,0,0"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="TourScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid>
   <StackPanel x:Name="WelcomeStep">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0"><Grid Height="76">
      <Border Width="28" Height="28" CornerRadius="14" Background="#BADBFF" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
      <Viewbox Width="76" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Canvas Width="80" Height="56"><Rectangle Width="74" Height="50" RadiusX="4" RadiusY="4" Canvas.Top="2" Canvas.Left="2" Stroke="#12437B" StrokeThickness="2" Fill="White"/><Path Data="M2,12 L76,12 M8,7 L45,7" Stroke="#12437B" StrokeThickness="2"/><Rectangle Width="12" Height="8" Fill="#A7D0FB" Canvas.Left="12" Canvas.Top="22"/><Rectangle Width="12" Height="8" Fill="#A7D0FB" Canvas.Left="12" Canvas.Top="36"/><Path Data="M31,26 L61,26 M31,40 L52,40" Stroke="#12437B" StrokeThickness="2"/><Path Data="M61,37 L78,48 71,49 75,55 70,58 66,50 61,54 Z" Fill="#12437B"/></Canvas></Viewbox>
     </Grid><TextBlock Text="Choose an app" Style="{StaticResource StepTitle}"/><TextBlock Text="Add an application to protect." Style="{StaticResource StepText}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="14,0" ><Grid Height="76">
      <Border Width="28" Height="28" CornerRadius="14" Background="#BADBFF" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
      <Viewbox Width="76" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Canvas Width="80" Height="56"><Rectangle Width="74" Height="50" RadiusX="4" RadiusY="4" Canvas.Top="2" Canvas.Left="2" Stroke="#12437B" StrokeThickness="2" Fill="White"/><Path Data="M2,12 L76,12 M8,7 L45,7" Stroke="#12437B" StrokeThickness="2"/><Rectangle Width="54" Height="30" Canvas.Left="12" Canvas.Top="17" RadiusX="8" RadiusY="8"><Rectangle.Fill><RadialGradientBrush><GradientStop Color="#82B5E9" Offset="0"/><GradientStop Color="#F6FAFE" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle></Canvas></Viewbox>
     </Grid><TextBlock Text="Adjust blur" Style="{StaticResource StepTitle}"/><TextBlock Text="Set the areas and strength to mask." Style="{StaticResource StepText}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="14,0,0,0"><Grid Height="76">
      <Border Width="28" Height="28" CornerRadius="14" Background="#BADBFF" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
      <Viewbox Width="76" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Canvas Width="80" Height="56"><Rectangle Width="74" Height="50" RadiusX="4" RadiusY="4" Canvas.Top="2" Canvas.Left="2" Stroke="#12437B" StrokeThickness="2" Fill="White"/><Path Data="M2,12 L76,12 M8,7 L45,7 M20,32 Q39,10 58,32 Q39,54 20,32 Z" Stroke="#12437B" StrokeThickness="2"/><Ellipse Width="10" Height="10" Canvas.Left="34" Canvas.Top="27" Stroke="#12437B" StrokeThickness="2"/></Canvas></Viewbox>
     </Grid><TextBlock Text="Reveal when needed" Style="{StaticResource StepTitle}"/><TextBlock Text="Use your PIN to unlock a panic mask." Style="{StaticResource StepText}"/></StackPanel>
    </Grid>
    <Border Height="1" Background="#E0E5E8" Margin="0,20,0,12"/>
    <TextBlock Text="Start with Windows" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><CheckBox x:Name="LaunchAtLoginCheckBox" Style="{StaticResource Switch}" AutomationProperties.Name="Launch when I sign in"/><TextBlock Text="Launch when I sign in" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="StartMinimizedCheckBox" Style="{StaticResource Switch}" AutomationProperties.Name="Start minimized to tray"/><TextBlock Text="Start minimized to tray" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
   </StackPanel>
   <ItemsControl x:Name="ShortcutStep" Visibility="Collapsed" AutomationProperties.Name="PrivacyMask keyboard shortcuts">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
         <TextBlock Text="{Binding CompactTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding ScopeSummary}" Style="{StaticResource StepText}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding RegistrationStatus}" Margin="0,4,0,0">
          <TextBlock.Style>
           <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
             <DataTrigger Binding="{Binding ShowRegistrationFailure}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <Border Grid.Column="1" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5"
                Padding="8,5" MaxWidth="150" VerticalAlignment="Top">
         <TextBlock Text="{Binding GestureText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
       </Grid>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,16,0,0">
   <Button x:Name="SkipButton" Content="_Skip tour" Click="Finish_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinHeight="44"/>
   <Button x:Name="BackButton" Content="_Back" Click="Back_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinHeight="44" Visibility="Collapsed"/>
   <Button x:Name="ContinueButton" Content="_Next: shortcuts" IsDefault="True" Click="Continue_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="124" MinHeight="44"/>
  </Grid>
 </Grid>
</Window>

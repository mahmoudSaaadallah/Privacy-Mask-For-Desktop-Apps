<Window x:Class="PrivacyMask.App.Windows.AddApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PrivacyMask.App.ViewModels"
        mc:Ignorable="d"
        Title="Add an application"
        Foreground="{StaticResource InkBrush}"
        Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
        Width="760"
        Height="640"
        MinWidth="620"
        MinHeight="520"
        FontFamily="Segoe UI Variable Text"
        Background="#F2ECE3"
        AutomationProperties.Name="Add an application to PrivacyMask"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#17313D"
                       Text="Add an application" />
            <TextBlock x:Name="DescriptionText"
                       Margin="0,8,0,0"
                       Foreground="#51656E"
                       TextWrapping="Wrap"
                       Text="Choose a running desktop app, or browse to its executable. PrivacyMask protects every visible window created by the selected process." />
        </StackPanel>

        <TextBox x:Name="SearchTextBox" Grid.Row="1" Margin="0,18,0,0" Padding="12,10" FontSize="14" AutomationProperties.Name="Search running applications" ToolTip="Search by application or process name" TextChanged="Search_TextChanged"/>
        <Grid Grid.Row="2"
              Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#17313D"
                       Text="Running applications" />
            <Button Grid.Column="1"
                    Width="104"
                    Margin="12,0,10,0"
                    Padding="10,7"
                    Style="{StaticResource SecondaryButton}" Click="Refresh_Click"
                    Content="_Refresh" />
            <Button Grid.Column="2"
                    Width="176"
                    Padding="10,7"
                    Background="#1F6E6C"
                    BorderBrush="#1F6E6C"
                    Foreground="White"
                    Style="{StaticResource SecondaryButton}" Click="Browse_Click"
                    Content="_Browse for executable" />
        </Grid>

        <Border Grid.Row="3"
                Padding="8"
                Background="#FCFAF6"
                BorderBrush="#DED4C4"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <ListBox x:Name="ApplicationsList"
                         AutomationProperties.Name="Available running applications"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemsSource="{Binding ApplicationsView}"
                         SelectionChanged="ApplicationsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ApplicationCandidateViewModel}">
                            <Grid Margin="8"
                                  ToolTip="{Binding Candidate.ExecutablePath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="32"
                                       Height="32"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Source="{Binding Icon}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#51656E"
                                               Text="{Binding ProcessSummary}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#6D777C"
                                               Text="{Binding WindowSummary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyStateText"
                           Margin="26"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#51656E"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="No eligible applications are currently visible. Open the application and refresh, or browse directly to its .exe file." />
            </Grid>
        </Border>

        <Border x:Name="ProfileNamePanel"
                Grid.Row="4"
                Margin="0,16,0,0"
                Padding="14"
                Background="#E8F1EF"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Profile name" />
                <TextBox x:Name="ProfileNameTextBox"
                         Grid.Column="1"
                         Margin="16,0,0,0"
                         Padding="8,6"
                         AutomationProperties.HelpText="You can change this friendly name later in the settings window."
                         MaxLength="80" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="5"
                   Margin="0,18,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#8A6A38"
                       x:Name="SelectedTargetText" MaxWidth="330" TextTrimming="CharacterEllipsis" Text="Choose an application" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button Width="104"
                        Margin="0,0,10,0"
                        Padding="12,8"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Content="_Cancel" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                        Width="146"
                        Padding="12,8"
                        Click="Add_Click"
                        Content="_Add application" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

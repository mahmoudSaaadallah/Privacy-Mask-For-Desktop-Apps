<Window x:Class="PrivacyMask.App.Windows.AddApplicationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:viewModels="clr-namespace:PrivacyMask.App.ViewModels" xmlns:services="clr-namespace:PrivacyMask.App.Services"
 Title="Add application" Width="560" Height="560" MinWidth="460" MinHeight="440"
 Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
 Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
 FontFamily="Segoe UI Variable Text" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.Name="Add an application to PrivacyMask">
 <Grid Margin="24" Background="{StaticResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Style="{StaticResource CircleHelp}" Content="i" AutomationProperties.Name="Application picker help" services:InformationHelp.Text="{Binding Text,ElementName=DescriptionText}"/>
   <TextBlock x:Name="HeadingText" Style="{StaticResource PageHeading}" Text="Add application" FontSize="24"/>
   <TextBlock x:Name="DescriptionText" Visibility="Collapsed" Text="Choose a running desktop app, or browse to its executable. Every eligible visible window created by the selected process is protected. Relink uses the same picker and preserves your settings."/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <TextBox x:Name="SearchTextBox" Style="{StaticResource ReferenceInput}" Padding="34,6,10,6" AutomationProperties.Name="Search running applications" TextChanged="Search_TextChanged"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource MutedInkBrush}"/>
    <TextBlock Text="Search running applications..." Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedInkBrush}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <DockPanel Grid.Row="1" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="↻  _Refresh" Style="{StaticResource SecondaryButton}" Padding="12,5" MinHeight="30" Click="Refresh_Click"/><TextBlock Text="Running applications" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5">
   <Grid>
    <ListBox x:Name="ApplicationsList" BorderThickness="0" Background="Transparent" ItemsSource="{Binding ApplicationsView}" SelectionChanged="ApplicationsList_SelectionChanged"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Available running applications">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent"><ContentPresenter/><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#EEF0F2"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style></Border.Style></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCF4F3"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:ApplicationCandidateViewModel}">
      <Grid Margin="12,8" ToolTip="{Binding Candidate.ExecutablePath}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Image Width="34" Height="34" HorizontalAlignment="Left"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding Icon}"/><Style.Triggers><DataTrigger Binding="{Binding Candidate.ProcessName}" Value="notepad"><Setter Property="Source" Value="{StaticResource NotepadSymbol}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ExecutableName}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyStateText" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
   </Grid>
  </Border>
  <Button Grid.Row="3" Content="▣  _Browse executable..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,6" MinHeight="32" Margin="0,8,0,0" Click="Browse_Click"/>
  <StackPanel x:Name="ProfileNamePanel" Grid.Row="4" Margin="0,12,0,0"><Label Content="Profile _name" Target="{Binding ElementName=ProfileNameTextBox}" Padding="0,0,0,6"/><TextBox x:Name="ProfileNameTextBox" Style="{StaticResource ReferenceInput}" Padding="10,6" MaxLength="80" AutomationProperties.Name="Application profile name"/></StackPanel>
  <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
    <TextBlock Text="Relink uses the same picker and preserves your settings." FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left"/>
    <TextBlock x:Name="SelectedTargetText" Text="Choose an application" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" MaxWidth="220" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="_Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="82"/>
    <Button x:Name="ConfirmButton" Content="_Add application" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="10,0,0,0" MinWidth="126"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>

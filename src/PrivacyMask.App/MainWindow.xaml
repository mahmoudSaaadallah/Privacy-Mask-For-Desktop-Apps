<Window
    x:Class="PrivacyMask.App.MainWindow"
    x:Name="SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PrivacyMask.App.ViewModels"
    xmlns:services="clr-namespace:PrivacyMask.App.Services"
    xmlns:models="clr-namespace:PrivacyMask.Core.Models;assembly=PrivacyMask.Core"
    mc:Ignorable="d"
    Title="PrivacyMask"
    Foreground="{StaticResource InkBrush}"
    Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
    Width="1000"
    Height="900"
    MinWidth="860"
    MinHeight="640"
    FontFamily="Segoe UI Variable Text"
    FontSize="14"
    Background="{StaticResource CanvasBrush}"
    AutomationProperties.Name="PrivacyMask settings"
    AutomationProperties.HelpText="Configure startup, hotkeys, application profiles, masks, and privacy zones."
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibility" />
        <services:PageSelectionConverter
            x:Key="PageSelection" />
        <Style
            x:Key="NavigationButton"
            TargetType="Button"
            BasedOn="{StaticResource ActionButton}">
            <Setter
                Property="Foreground"
                Value="White" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Left" />
            <Setter
                Property="Margin"
                Value="0,4" />
            <Setter
                Property="MinHeight"
                Value="48" />
            <Style.Triggers>
                <DataTrigger
                    Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding
                            Converter="{StaticResource PageSelection}">
                            <Binding
                                Path="SelectedPage" />
                            <Binding
                                Path="Tag"
                                RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter
                        Property="Background"
                        Value="#245673" />
                    <Setter
                        Property="BorderBrush"
                        Value="#00B6AD" />
                    <Setter
                        Property="BorderThickness"
                        Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    <services:EnumSelectionConverter x:Key="EnumSelection"/>
    <services:MaskColorBrushConverter x:Key="MaskColorBrush"/>
    <Style x:Key="ApplicationIcon" TargetType="Image">
        <Setter Property="Source" Value="{Binding Icon}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNotepad}" Value="True"><Setter Property="Source" Value="{StaticResource NotepadSymbol}"/></DataTrigger>
            <DataTrigger Binding="{Binding AppId}" Value="{x:Static models:AppId.WhatsApp}"><Setter Property="Source" Value="{StaticResource WhatsAppSymbol}"/></DataTrigger>
            <DataTrigger Binding="{Binding AppId}" Value="{x:Static models:AppId.Telegram}"><Setter Property="Source" Value="{StaticResource TelegramSymbol}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="StatusBadge">
        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{Binding StatusBadgeColor}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeColor}" FontSize="12"/></StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ApplicationDetailTemplate" DataType="{x:Type viewModels:AppProfileViewModel}">

 <StackPanel>
  <TextBlock Text="{Binding CardDisplayName, StringFormat={}{0} settings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" TextWrapping="Wrap"/>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
   <Image Style="{StaticResource ApplicationIcon}" Width="64" Height="64" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Text="Name" Margin="0,0,0,8"/><TextBox Style="{StaticResource ReferenceInput}" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBuiltIn}" MaxLength="80" Padding="10,8" FontSize="14" AutomationProperties.Name="Application profile name"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Enabled" Margin="0,0,0,10"/><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable application masking" HorizontalAlignment="Left"/></StackPanel>
  </Grid>
  <Border Height="1" Background="#E6E8EA" Margin="0,0,0,24"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Blur strength" VerticalAlignment="Center"/>
   <DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Right" Text="{Binding MaskIntensityPercent,StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="18,0,0,0" MinWidth="44"/><Slider Style="{StaticResource BlurSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MaskIntensityPercent}" AutomationProperties.Name="Blur strength"/></DockPanel>
   <TextBlock Grid.Row="1" Text="Mask style" VerticalAlignment="Center" Margin="0,24,0,0"/>
   <ComboBox Style="{StaticResource ReferenceCombo}" Grid.Row="1" Grid.Column="1" Margin="0,24,0,0" Width="230" HorizontalAlignment="Left" Padding="8" Background="White" ItemsSource="{Binding MaskStylesSource,ElementName=SettingsWindow}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding PrimaryMaskStyle}" AutomationProperties.Name="Mask style"/>
   <TextBlock Grid.Row="2" Text="Mask color" VerticalAlignment="Center" Margin="0,20,0,0"/>
   <ComboBox Style="{StaticResource ReferenceCombo}" Grid.Row="2" Grid.Column="1" Margin="0,20,0,0" Width="230" HorizontalAlignment="Left" Padding="8" Background="White" ItemsSource="{Binding MaskColorsSource,ElementName=SettingsWindow}" SelectedItem="{Binding MaskColor}" AutomationProperties.Name="Mask color"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="18" Height="18" Fill="{Binding Converter={StaticResource MaskColorBrush}}" Stroke="#D5DADF" Margin="0,0,8,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Grid.Row="3" Text="Activation" VerticalAlignment="Center" Margin="0,28,0,0"/>
   <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,28,0,0">
    <RadioButton Style="{StaticResource ActivationRadio}" Content="Always while visible" GroupName="Activation" IsChecked="{Binding StartupMode, Converter={StaticResource EnumSelection}, ConverterParameter={x:Static models:AppActivationMode.Manual}}" Margin="0,0,20,8" AutomationProperties.Name="Always mask while visible"/>
    <RadioButton Content="Only while focused" GroupName="Activation" IsChecked="{Binding StartupMode, Converter={StaticResource EnumSelection}, ConverterParameter={x:Static models:AppActivationMode.FocusAware}}" Margin="0,0,0,8" AutomationProperties.Name="Mask only while focused"/>
   </WrapPanel>
   <TextBlock Grid.Row="4" Text="Hover reveal" VerticalAlignment="Center" Margin="0,24,0,0"/>
   <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,24,0,0">
    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HoverRevealEnabled}" AutomationProperties.Name="Enable hover reveal" Margin="0,0,24,8"/>
    <StackPanel Margin="0,0,20,8"><TextBlock Text="Width" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource ReferenceInput}" Width="76" Padding="8" Text="{Binding HoverRevealWidthPixels,UpdateSourceTrigger=LostFocus}" PreviewTextInput="NumericTextBox_PreviewTextInput" AutomationProperties.Name="Hover reveal width"/><TextBlock Text="px" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
    <StackPanel Margin="0,0,0,8"><TextBlock Text="Height" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><TextBox Style="{StaticResource ReferenceInput}" Width="76" Padding="8" Text="{Binding HoverRevealHeightPixels,UpdateSourceTrigger=LostFocus}" PreviewTextInput="NumericTextBox_PreviewTextInput" AutomationProperties.Name="Hover reveal height"/><TextBlock Text="px" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
   </WrapPanel>
  </Grid>
  <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Background="#F5F5F5" Margin="0,20,0,0">
   <StackPanel>

    <Expander Style="{StaticResource ReferenceExpander}"
                                                        AutomationProperties.Name="Advanced privacy zones"
                                                        AutomationProperties.HelpText="Expand to edit normalized zone coordinates, styles, blur strength, and reveal behavior."
                                                        Header="_Advanced privacy zones">
                                                        <StackPanel
                                                            Margin="0,10,0,0">
<DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Apply preset" Tag="{Binding}" Click="ApplyPreset_Click"/><ComboBox Margin="0,0,16,0" Padding="8" ItemsSource="{Binding Presets}" DisplayMemberPath="DisplayName" SelectedValuePath="PresetId" SelectedValue="{Binding SelectedPresetId}" AutomationProperties.Name="Layout preset"/></DockPanel>
                                                            <TextBlock
                                                                Margin="0,0,0,8"
                                                                Foreground="#51656E"
                                                                TextWrapping="Wrap"
                                                                Text="X, Y, width, and height use 0.00–1.00 coordinates and must stay inside the app. Blur strength supports 0–100%." />
                                                            <DataGrid
                                                                AutoGenerateColumns="False"
                                                                AutomationProperties.Name="Privacy zones"
                                                                AutomationProperties.HelpText="Advanced settings. Edit normalized regions from zero to one and a blur strength from zero to one hundred percent."
                                                                CanUserAddRows="False"
                                                                HeadersVisibility="Column"
                                                                ItemsSource="{Binding Zones}"
                                                                RowBackground="#FCFAF6"
                                                                AlternatingRowBackground="#F7F1E7"
                                                                BorderThickness="0"
                                                                GridLinesVisibility="Horizontal"
                                                                MinHeight="260">
                                                                <DataGrid.Columns>
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding Enabled, Mode=TwoWay}"
                                                                        Header="On"
                                                                        Width="55" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        Header="Zone"
                                                                        Width="170" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="X"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="Y"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="W"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="H"
                                                                        Width="70" />
                                                                    <DataGridTemplateColumn
                                                                        Header="Style"
                                                                        Width="130">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock
                                                                                    Text="{Binding StyleDisplayName}" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                                            <DataTemplate>
                                                                                <ComboBox
                                                                                    ItemsSource="{Binding MaskStylesSource, ElementName=SettingsWindow}"
                                                                                    DisplayMemberPath="DisplayName"
                                                                                    SelectedValue="{Binding Style, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    SelectedValuePath="Value" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                                    </DataGridTemplateColumn>
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding SurfaceIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                                                        Header="Blur %"
                                                                        Width="90" />
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding RevealOnHover, Mode=TwoWay}"
                                                                        Header="Hover reveal"
                                                                        Width="110" />
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding HideDuringTemporaryReveal, Mode=TwoWay}"
                                                                        Header="Hold reveal"
                                                                        Width="105" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Expander>
   </StackPanel>
  </Border>
  <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Visibility="{Binding IsCustom,Converter={StaticResource BooleanToVisibility}}">
   <Button Content="Relink application" Style="{StaticResource SecondaryButton}" Click="RelinkApplication_Click" Tag="{Binding}" Margin="0,0,12,0"/>
   <Button Content="Remove profile" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}" Click="RemoveApplication_Click" Tag="{Binding}"/>
  </StackPanel>
 </StackPanel>
</DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" Padding="10,24,6,24">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,0,0,28">
                    <StackPanel Margin="10,0,0,6"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSecondaryDesignPage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="PM" FontSize="36" FontWeight="Black" Foreground="White"/><TextBlock Text="PrivacyMask" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSecondaryDesignPage,Converter={StaticResource BooleanToVisibility}}"><Border Width="44" Height="44" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="PM" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PrivacyMask" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.Overview}" Click="Navigate_Click" AutomationProperties.Name="Overview"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="Overview" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.Applications}" Click="Navigate_Click" AutomationProperties.Name="Applications"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="Applications" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.Shortcuts}" Click="Navigate_Click" AutomationProperties.Name="Shortcuts"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="Shortcuts" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.Security}" Click="Navigate_Click" AutomationProperties.Name="Security"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="Security" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.Settings}" Click="Navigate_Click" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="Settings" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{x:Static viewModels:DesktopPage.About}" Click="Navigate_Click" AutomationProperties.Name="About"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Width="28"/><TextBlock Text="About" Foreground="White" FontWeight="Normal"/></StackPanel></Button>
                </StackPanel></ScrollViewer>
            </DockPanel>
        </Border>
        <Grid
            Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Background="{StaticResource CanvasBrush}">
                <Grid>

                    <ScrollViewer x:Name="OverviewPage" Visibility="{Binding IsOverviewPage,Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto">
                     <StackPanel Margin="28">
                      <DockPanel Margin="0,0,0,26"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="Pause all and Panic mask all affect every protected app immediately. Mask settings below use Save and Discard." AutomationProperties.Name="Overview help"/><TextBlock Text="Overview" Style="{StaticResource PageHeading}"/></DockPanel>
                      <Border Background="{Binding ProtectionBannerBackground}" CornerRadius="10" Padding="24" Margin="0,0,0,26">
                       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="{Binding ProtectionBannerColor}" VerticalAlignment="Center" AutomationProperties.Name="Protection state"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding ProtectionBannerText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><Ellipse Fill="{Binding ProtectionBannerColor}" Width="7" Height="7" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="{Binding GlobalPauseLabel}" IsEnabled="{Binding CanToggleGlobalProtection}" Click="GlobalProtection_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" AutomationProperties.HelpText="Immediately pause or resume all profiles; individual pauses remain unchanged."/><Button Content="{Binding GlobalPanicLabel}" IsEnabled="{Binding CanToggleGlobalPanic}" Click="GlobalPanic_Click" Style="{StaticResource DangerButton}" AutomationProperties.HelpText="Immediately mask all protected apps. Unlocking requires your saved PIN."/></WrapPanel>
                       </Grid>
                      </Border>
                      <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="＋  Add application" Click="AddApplication_Click" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Applications" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                      <TextBlock Text="No applications configured. Add one to start protecting it." Visibility="{Binding HasNoApplications,Converter={StaticResource BooleanToVisibility}}" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding OverviewAppProfiles}">
                       <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:AppProfileViewModel}">
                        <Border Style="{StaticResource Card}" BorderBrush="#F0F1F3" Margin="0,0,0,14" Padding="22">
                         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Image Style="{StaticResource ApplicationIcon}" Width="62" Height="62" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                          <StackPanel Grid.Column="1" Margin="0,0,20,0">
                           <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CardDisplayName}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="290" TextTrimming="CharacterEllipsis"/><Button Style="{StaticResource InformationButton}" Width="26" MinWidth="26" Height="26" MinHeight="26" FontSize="14" Margin="4,0,0,0" services:InformationHelp.Text="{Binding ApplicationHelp}" AutomationProperties.Name="{Binding DisplayName,StringFormat=Information about {0}}"/></StackPanel>
                           <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,7,0,14"/>
                           <TextBlock Text="Blur strength" FontSize="12" Margin="0,0,0,3"/>
                           <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding MaskIntensityPercent,StringFormat={}{0:0}%}" MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider Style="{StaticResource BlurSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MaskIntensityPercent,Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName,StringFormat=Blur strength for {0}}"/></DockPanel>
                          </StackPanel>
                          <Button Grid.Column="2" Content="Manage" Tag="{Binding}" Click="ManageApplication_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                         </Grid>
                        </Border>
                       </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="Manage all applications" Style="{StaticResource SecondaryButton}" Tag="{x:Static viewModels:DesktopPage.Applications}" Click="Navigate_Click" HorizontalAlignment="Left" Visibility="{Binding HasMoreOverviewApplications,Converter={StaticResource BooleanToVisibility}}"/>
                      <TextBlock Text="Quick shortcut" FontWeight="SemiBold" Margin="0,18,0,10"/>
                      <WrapPanel><ItemsControl ItemsSource="{Binding QuickShortcutKeys}" Margin="0,0,12,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="+" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding HasSeparator,Converter={StaticResource BooleanToVisibility}}"/><Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Background="#F0F2F4" Padding="14,7" CornerRadius="5"><TextBlock Text="{Binding Text}"/></Border></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Toggle mask on active application" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
                     </StackPanel>
                    </ScrollViewer>
                    <Grid>

 <Border x:Name="ApplicationsPage" Visibility="{Binding IsApplicationListPage,Converter={StaticResource BooleanToVisibility}}" Padding="28">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,26"><Button DockPanel.Dock="Right" Content="?" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="Search configured apps, enable or disable their masks, and use Manage to adjust appearance. Changes are saved together." AutomationProperties.Name="Applications help"/><TextBlock Text="Applications" Style="{StaticResource PageHeading}"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,20,0">
     <TextBox Style="{StaticResource ReferenceInput}" x:Name="ApplicationSearchBox" Text="{Binding ApplicationSearch,UpdateSourceTrigger=PropertyChanged}" Padding="38,12,12,12" FontSize="14" AutomationProperties.Name="Search applications"/>
     <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource MutedInkBrush}"/>
     <TextBlock Text="Search applications..." Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApplicationSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Grid.Column="1" Content="＋  Add application" Click="AddApplication_Click" Style="{StaticResource PrimaryButton}"/>
   </Grid>
   <Border Grid.Row="2" Background="White" CornerRadius="10" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}">
    <ListBox ItemsSource="{Binding FilteredAppProfiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Configured applications">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:AppProfileViewModel}">
      <Border Padding="22,26" BorderBrush="#EFF1F3" BorderThickness="0,0,0,1">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Style="{StaticResource ApplicationIcon}" Width="62" Height="62" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CardDisplayName}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="270" TextTrimming="CharacterEllipsis"/><Button Style="{StaticResource InformationButton}" Width="26" MinWidth="26" Height="26" MinHeight="26" FontSize="14" Margin="4,0,0,0" services:InformationHelp.Text="{Binding ApplicationHelp}" AutomationProperties.Name="{Binding DisplayName,StringFormat=Information about {0}}"/></StackPanel>
         <WrapPanel Margin="0,8,0,0"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}"/><Button Content="Relink" Background="Transparent" BorderThickness="0" Foreground="#007AFF" Margin="8,0,0,0" Visibility="{Binding NeedsRelink,Converter={StaticResource BooleanToVisibility}}" Click="RelinkApplication_Click" Tag="{Binding}"/></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled,Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName,StringFormat=Enable {0} masking}" Margin="0,0,22,0"/><Button Content="Manage" Click="ManageApplication_Click" Tag="{Binding}" Style="{StaticResource SecondaryButton}"/></StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <TextBlock Grid.Row="2" Text="{Binding ApplicationEmptyMessage}" Visibility="{Binding HasNoMatchingApplications,Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </Grid>
 </Border>
 <ScrollViewer x:Name="ApplicationDetailsPage" Visibility="{Binding IsApplicationDetailsPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24">
   <Button Content="←  Back to Applications" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#007AFF" Click="BackToApplications_Click" Margin="0,0,0,20"/>
   <ContentControl Content="{Binding SelectedApplication}" ContentTemplate="{StaticResource ApplicationDetailTemplate}" />
  </StackPanel>
 </ScrollViewer>
</Grid>

                    <ScrollViewer x:Name="ShortcutsPage" Visibility="{Binding IsShortcutsPage,Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28">
                            <TextBlock Text="Shortcuts" Style="{StaticResource PageHeading}" Margin="0,0,0,26"/>
                            <Border Style="{StaticResource Card}" Padding="0" BorderBrush="#E7EBEE">
                                <ItemsControl ItemsSource="{Binding ShortcutRows}">
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type viewModels:HotkeyBindingViewModel}">
                                        <Border BorderBrush="#EDF0F2" BorderThickness="0,0,0,1" Padding="18,22">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ShowRegistrationFailure}" Value="True"><Setter Property="Background" Value="#FFF4E2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                                <WrapPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock Text="{Binding CompactTitle}" TextWrapping="Wrap" MaxWidth="180" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Style="{StaticResource CircleHelp}" Content="i" Width="20" Height="20" MinWidth="20" MinHeight="20" Margin="6,0,0,0" services:InformationHelp.Text="{Binding InformationText}" AutomationProperties.Name="{Binding CompactTitle,StringFormat=Information about {0}}"/></WrapPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding GestureKeys}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="+" VerticalAlignment="Center" Margin="5,0" Visibility="{Binding HasSeparator,Converter={StaticResource BooleanToVisibility}}"/><Border Background="#F0F2F4" BorderBrush="#DDE2E6" BorderThickness="1" CornerRadius="5" Padding="10,8"><TextBlock Text="{Binding Text}" FontSize="13"/></Border></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding HoldDelayText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Enabled,Mode=TwoWay}" AutomationProperties.Name="{Binding CompactTitle,StringFormat=Enable {0}}" AutomationProperties.HelpText="Enable or disable after Save. Scope and actual registration are explained by the information button."/>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="{Binding HasAttentionMessage,Converter={StaticResource BooleanToVisibility}}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="⚠" Foreground="#CF8200" FontSize="20"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AttentionHeading}" Foreground="#AC6500" FontWeight="SemiBold" Margin="0,3,14,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AttentionDetail}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SecurityPage" Visibility="{Binding IsSecurityPage,Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">
                            <TextBlock Text="Security" Style="{StaticResource PageHeading}" Margin="0,0,0,26"/>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="i" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="Create a 4–8 digit PIN, or change it after verifying the current PIN. Save changes on this page to persist it. Cancel leaves the existing PIN unchanged. Only a salted hardened verifier is stored." AutomationProperties.Name="Panic PIN information"/><TextBlock Text="Panic unlock PIN" FontSize="20" FontWeight="SemiBold"/></DockPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{Binding PanicPinIndicatorColor}" Margin="0,0,14,0"><TextBlock Text="{Binding PanicPinIndicator}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <TextBlock Text="{Binding PanicPinCompactStatus}" VerticalAlignment="Center" FontSize="16" AutomationProperties.Name="Panic PIN status" AutomationProperties.HelpText="{Binding PanicPinStatus}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding PanicPinActionLabel}" Click="ConfigurePanicPin_Click" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,22,0,0">
                                <StackPanel>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="i" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="These tabs explain existing panic modes; they do not activate protection or change shortcut scope. Focused panic affects one app. Global panic covers every detected protected app. Wrong PIN, Cancel or closing unlock leaves protection active; hover and Alt cannot bypass panic." AutomationProperties.Name="Panic protection information"/><TextBlock Text="Panic protection" FontSize="20" FontWeight="SemiBold"/></DockPanel>
                                    <TextBlock Text="Choose a mode to see how it works." Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,10,0,14"/>
                                    <WrapPanel>
                                        <RadioButton Content="Active app" GroupName="PanicExplanation" Style="{StaticResource ModeChip}" IsChecked="{Binding PanicHelpScope,Converter={StaticResource EnumSelection},ConverterParameter={x:Static viewModels:PanicHelpScope.ActiveApp}}" Margin="0,0,14,8" AutomationProperties.Name="Explain focused app panic" AutomationProperties.HelpText="Information only; this does not change protection."/>
                                        <RadioButton Content="All apps" GroupName="PanicExplanation" Style="{StaticResource ModeChip}" IsChecked="{Binding PanicHelpScope,Converter={StaticResource EnumSelection},ConverterParameter={x:Static viewModels:PanicHelpScope.AllApps}}" Margin="0,0,0,8" AutomationProperties.Name="Explain global panic" AutomationProperties.HelpText="Information only; this does not change protection."/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PanicScopeSummary}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,22,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="i" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="All settings stay on this device. PrivacyMask has no cloud account or background telemetry. The PIN guards panic unlock, not Windows sign-in or access to the local settings file." AutomationProperties.Name="Local settings information"/><TextBlock Text="Local settings" FontSize="20" FontWeight="SemiBold"/></DockPanel>
                                    <StackPanel Orientation="Horizontal"><Canvas Width="36" Height="36" Margin="0,0,20,0"><Ellipse Width="28" Height="10" Canvas.Left="4" Canvas.Top="2" Stroke="{StaticResource InkBrush}" StrokeThickness="2"/><Path Data="M4,7 L4,28 C4,34 32,34 32,28 L32,7 M4,16 C4,22 32,22 32,16 M4,24 C4,30 32,30 32,24" Stroke="{StaticResource InkBrush}" StrokeThickness="2"/></Canvas><TextBlock Text="No cloud account" VerticalAlignment="Center" FontSize="16"/></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="{Binding IsSettingsPage,Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">
                            <TextBlock Text="Settings" Style="{StaticResource PageHeading}" Margin="0,0,0,26"/>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Startup" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <DockPanel Margin="0,12,0,18"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtLogin,Mode=TwoWay}" AutomationProperties.Name="Launch when I sign in" AutomationProperties.HelpText="Starts PrivacyMask for this Windows user after saving. Existing preferences are preserved on updates."/><TextBlock Text="Launch when I sign in" VerticalAlignment="Center"/></DockPanel>
                                    <Border Height="1" Background="#EEF1F3"/>
                                    <DockPanel Margin="0,18,0,4"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized,Mode=TwoWay}" AutomationProperties.Name="Start minimized to tray" AutomationProperties.HelpText="Keep the settings window hidden on startup after saving."/><TextBlock Text="Start minimized to tray" VerticalAlignment="Center"/></DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="About" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,18,0"><TextBlock Text="PM" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{x:Static services:AboutInformation.ProductLabel}" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                        <Button Grid.Column="1" Content="About" Style="{StaticResource SecondaryButton}" Tag="{x:Static viewModels:DesktopPage.About}" Click="Navigate_Click" MinWidth="110"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,22,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Path Data="M6,1 L20,1 27,8 27,32 6,32 Z M20,1 L20,8 27,8 M11,15 L22,15 M11,21 L22,21 M11,27 L18,27" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" Width="30" Height="34" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <DockPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center"><Button DockPanel.Dock="Right" Content="i" Style="{StaticResource CircleHelp}" services:InformationHelp.Text="{Binding ConfigPath}" AutomationProperties.Name="Configuration file path"/><TextBlock Text="Configuration file" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                                    <Button Grid.Column="2" Content="Show location" Style="{StaticResource SecondaryButton}" Click="OpenConfigurationFolder_Click" AutomationProperties.HelpText="Open the local settings folder. Right-click or Shift+F10 to copy the settings file path."><Button.ContextMenu><ContextMenu><MenuItem Header="Copy file path" Click="CopyConfigurationPath_Click"/></ContextMenu></Button.ContextMenu></Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="AboutPage"
                        Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="About PrivacyMask"
                                Margin="0,0,0,24" />
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Image Source="{StaticResource PrivacyMaskLogo}" Width="64" Height="64" Margin="0,0,20,0"/>
                                    <StackPanel><TextBlock Text="PrivacyMask" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{x:Static services:AboutInformation.VersionText}" AutomationProperties.Name="PrivacyMask product version" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0"/></StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static services:AboutInformation.Developer}" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Software Engineer" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,12"/>
                                    <TextBlock Text="Hi, I'm Mahmoud Saadallah, a software engineer focused on building secure and privacy-first applications." TextWrapping="Wrap"/>
                                    <TextBlock Text="Why this app?" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
                                    <TextBlock Text="PrivacyMask gives you control over what remains visible when your chosen desktop apps are open. It protects message content with local overlays, without injecting into applications or compromising your privacy." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacy commitment" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="No tracking, analytics, hidden data collection, or third-party services. All settings stay on your device. Live-blur frames stay in memory and are never saved or sent anywhere." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedInkBrush}"/>
                                    <TextBlock Text="Capture limitation" FontWeight="SemiBold" Margin="0,18,0,8"/>
                                    <TextBlock Text="Designed for local privacy and best-effort full-screen sharing. Window-only sharing may omit the mask. Blur can retain visible detail; use solid redact or panic when content must be fully concealed." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Contact and support" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Bugs and suggestions" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,8"/>
                                    <TextBox Text="{x:Static services:AboutInformation.SupportEmail}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="Support email address"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Email developer" Tag="email" Click="DeveloperContact_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                        <Button Content="Copy email" Click="CopySupportEmail_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                        <Button Content="GitHub" Tag="github" Click="DeveloperContact_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
                                        <Button Content="LinkedIn" Tag="linkedin" Click="DeveloperContact_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ContactFeedback" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="Thank you for using PrivacyMask. Local-first by design." Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Padding="28,16,28,24"
                Visibility="{Binding IsSaveBarVisible,Converter={StaticResource BooleanToVisibility}}"
                Background="{StaticResource CanvasBrush}">
                <DockPanel
                    LastChildFill="True">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="DiscardButton"
                            Content="Discard"
                            Style="{StaticResource SecondaryButton}"
                            Click="CloseToTray_Click"
                            Margin="0,0,12,0" />
                        <Button
                            x:Name="SaveButton"
                            Content="Save changes"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanSave}"
                            Click="Save_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="16" Height="16" CornerRadius="8" Background="#E2A12A" Margin="0,0,9,0" Visibility="{Binding HasPendingChanges,Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="!" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding EditStatus}" VerticalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingChanges}" Value="True"><Setter Property="Foreground" Value="#D88D00"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="PrivacyMask.App.MainWindow"
        x:Name="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PrivacyMask.App.ViewModels"
        xmlns:services="clr-namespace:PrivacyMask.App.Services"
        mc:Ignorable="d"
        Title="PrivacyMask"
        Foreground="{StaticResource InkBrush}"
        Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
        Width="1460"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        FontFamily="Segoe UI Variable Text"
        Background="#F2ECE3"
        AutomationProperties.Name="PrivacyMask settings"
        AutomationProperties.HelpText="Configure startup, hotkeys, application profiles, masks, and privacy zones."
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <services:PageSelectionConverter x:Key="PageSelection" />
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="48" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource PageSelection}">
                            <Binding Path="SelectedPage" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#245673" />
                    <Setter Property="BorderBrush" Value="#00B6AD" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" CornerRadius="16" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <Image Source="{StaticResource PrivacyMaskLogo}" Width="56" Height="56" HorizontalAlignment="Left" />
                    <TextBlock Text="PrivacyMask" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel><Button Content="Overview" Tag="{x:Static viewModels:DesktopPage.Overview}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button>
<Button Content="Applications" Tag="{x:Static viewModels:DesktopPage.Applications}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button>
<Button Content="Shortcuts" Tag="{x:Static viewModels:DesktopPage.Shortcuts}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button>
<Button Content="Security" Tag="{x:Static viewModels:DesktopPage.Security}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button>
<Button Content="Settings" Tag="{x:Static viewModels:DesktopPage.Settings}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button>
<Button Content="About" Tag="{x:Static viewModels:DesktopPage.About}" Style="{StaticResource NavigationButton}" Click="Navigate_Click"><Button.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style></Button.Resources></Button></StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="#FCFAF6" CornerRadius="16">
                <Grid>
                    <ScrollViewer x:Name="OverviewPage" Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Style="{StaticResource PageHeading}" Text="Overview" Margin="0,0,0,24" /><Border Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Protection status" /><TextBlock Text="{Binding CurrentModeSummary}" TextWrapping="Wrap" Margin="0,12,0,20" /><Button Style="{StaticResource PrimaryButton}" Content="Manage applications" HorizontalAlignment="Left" Tag="{x:Static viewModels:DesktopPage.Applications}" Click="Navigate_Click" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock FontWeight="SemiBold" Text="Quick enrollment" /><TextBlock Text="Focus an application and press Ctrl + Shift + P to add it or toggle its mask." TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border></StackPanel></ScrollViewer>
                    <Border x:Name="ApplicationsPage" Visibility="{Binding IsApplicationsPage, Converter={StaticResource BooleanToVisibility}}"
                Padding="24"
                Background="#FCFAF6"
                CornerRadius="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="30"
                                   FontWeight="Bold"
                                   Text="App Profiles" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#51656E"
                                   Text="Add desktop applications, tune their protection, and calibrate privacy zones." />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#8A6A38"
                                   Text="{Binding ConfigPath}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="170"
                            Margin="20,0,0,0"
                            Padding="16,11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#1F6E6C"
                            BorderBrush="#1F6E6C"
                            Foreground="White"
                            AutomationProperties.HelpText="Choose a running desktop application or browse to an executable file."
                            Click="AddApplication_Click"
                            Content="_Add application" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AppProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AppProfileViewModel}">
                                <Border Margin="0,0,0,18"
                                        Padding="20"
                                        Background="White"
                                        CornerRadius="22"
                                        BorderBrush="#E9E1D3"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBox FontSize="22"
                                                         FontWeight="Bold"
                                                         IsReadOnly="{Binding IsBuiltIn}"
                                                         MaxLength="80"
                                                         Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="ToolTip" Value="Built-in application profile" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                    <Setter Property="Padding" Value="7,3" />
                                                                    <Setter Property="Background" Value="#F7F1E7" />
                                                                    <Setter Property="BorderBrush" Value="#C3B6A2" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="ToolTip" Value="Rename this application profile" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="#51656E"
                                                           Text="{Binding Summary}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding RuntimeStatusColor}"
                                                           AutomationProperties.Name="{Binding RuntimeStatusSummary, StringFormat=Application status: {0}}"
                                                           Text="{Binding RuntimeStatusSummary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Orientation="Horizontal">
                                                <Button Margin="0,0,10,0"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibility}}"
                                                        AutomationProperties.HelpText="Choose a replacement executable while preserving this profile's mask settings."
                                                        Click="RelinkApplication_Click"
                                                        Content="_Relink"
                                                        Tag="{Binding}" />
                                                <Button Margin="0,0,14,0"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Background="#F3E5E1"
                                                        BorderBrush="#C98270"
                                                        Foreground="#8E3024"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibility}}"
                                                        Click="RemoveApplication_Click"
                                                        Content="_Remove"
                                                        Tag="{Binding}" />
                                                <CheckBox VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Enable {0} masking}"
                                                          Content="Enabled"
                                                          Click="ProfileEnabled_Click"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,16,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Activation mode" />
                                                <ComboBox Margin="0,8,0,0"
                                                          AutomationProperties.Name="Activation mode"
                                                          AutomationProperties.HelpText="Choose whether masking follows focus or remains active while the app window is visible."
                                                          ItemsSource="{Binding ActivationModesSource, ElementName=SettingsWindow}"
                                                          SelectedItem="{Binding StartupMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,16,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Preset" />
                                                <ComboBox Margin="0,8,0,0"
                                                          AutomationProperties.Name="Layout preset"
                                                          AutomationProperties.HelpText="Choose a built-in mask layout before applying it."
                                                          DisplayMemberPath="DisplayName"
                                                          ItemsSource="{Binding Presets}"
                                                          SelectedValue="{Binding SelectedPresetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="PresetId" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Width="132"
                                                    Margin="0,22,0,0"
                                                    Padding="14,10"
                                                    Background="#1F6E6C"
                                                    BorderBrush="#1F6E6C"
                                                    Click="ApplyPreset_Click"
                                                    Content="_Apply preset"
                                                    Tag="{Binding}" />
                                        </Grid>

                                        <Border Margin="0,0,0,16"
                                                Padding="16"
                                                Background="#F7F1E7"
                                                CornerRadius="18">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Blur strength" />

                                                <Slider Grid.Column="1"
                                                        Margin="18,0,18,0"
                                                        AutomationProperties.Name="Blur strength"
                                                        AutomationProperties.HelpText="Adjust live blur from zero to one hundred percent. Lower values reveal progressively clearer content; higher values hide more detail."
                                                        Minimum="0"
                                                        Maximum="100"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="MaskIntensitySlider_ValueChanged"
                                                        Value="{Binding MaskIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8A6A38"
                                                           Text="{Binding MaskIntensitySummary}" />

                                                <TextBlock Grid.Row="1"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Mask style" />

                                                <ComboBox Grid.Row="1"
                                                          Grid.Column="1"
                                                          Margin="18,18,18,0"
                                                          AutomationProperties.Name="Mask style"
                                                          AutomationProperties.HelpText="Choose live blur, wet glass, pixelated, or solid redact."
                                                          DisplayMemberPath="DisplayName"
                                                          ItemsSource="{Binding MaskStylesSource, ElementName=SettingsWindow}"
                                                          SelectedValue="{Binding PrimaryMaskStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value"
                                                          SelectionChanged="MaskStyleSelectionChanged" />

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="2"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8A6A38"
                                                           Text="{Binding MaskStyleSummary}" />

                                                <TextBlock Grid.Row="2"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Mask color" />

                                                <ComboBox Grid.Row="2"
                                                          Grid.Column="1"
                                                          Margin="18,18,18,0"
                                                          AutomationProperties.Name="Mask color"
                                                          ItemsSource="{Binding MaskColorsSource, ElementName=SettingsWindow}"
                                                          SelectedItem="{Binding MaskColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectionChanged="MaskColorSelectionChanged" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="2"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8A6A38"
                                                           Text="{Binding MaskColorSummary}" />

                                                <TextBlock Grid.Row="3"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Hover window (px)" />

                                                <StackPanel Grid.Row="3"
                                                            Grid.Column="1"
                                                            Margin="18,18,18,0"
                                                            Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="#51656E"
                                                               Text="W" />
                                                    <TextBox Width="86"
                                                              Margin="8,0,14,0"
                                                              HorizontalContentAlignment="Center"
                                                              AutomationProperties.Name="Hover reveal width in pixels"
                                                              AutomationProperties.HelpText="Enter a width from 80 to 1400 pixels."
                                                              LostFocus="HoverRevealDimension_LostFocus"
                                                              PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                              Text="{Binding HoverRevealWidthPixels, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                              ToolTip="80–1400 pixels" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="#51656E"
                                                               Text="H" />
                                                    <TextBox Width="86"
                                                              Margin="8,0,0,0"
                                                              HorizontalContentAlignment="Center"
                                                              AutomationProperties.Name="Hover reveal height in pixels"
                                                              AutomationProperties.HelpText="Enter a height from 20 to 420 pixels."
                                                              LostFocus="HoverRevealDimension_LostFocus"
                                                              PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                              Text="{Binding HoverRevealHeightPixels, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                              ToolTip="20–420 pixels" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="2"
                                                           Margin="0,18,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8A6A38"
                                                           Text="{Binding HoverRevealSummary}" />
                                            </Grid>
                                        </Border>

                                        <Expander AutomationProperties.Name="Advanced privacy zones"
                                                  AutomationProperties.HelpText="Expand to edit normalized zone coordinates, styles, blur strength, and reveal behavior."
                                                  Header="_Advanced privacy zones">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Margin="0,0,0,8"
                                                           Foreground="#51656E"
                                                           TextWrapping="Wrap"
                                                           Text="X, Y, width, and height use 0.00–1.00 coordinates and must stay inside the app. Blur strength supports 0–100%." />

                                                <DataGrid AutoGenerateColumns="False"
                                                          AutomationProperties.Name="Privacy zones"
                                                          AutomationProperties.HelpText="Advanced settings. Edit normalized regions from zero to one and a blur strength from zero to one hundred percent."
                                                          CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          ItemsSource="{Binding Zones}"
                                                          RowBackground="#FCFAF6"
                                                          AlternatingRowBackground="#F7F1E7"
                                                          BorderThickness="0"
                                                          GridLinesVisibility="Horizontal"
                                                          MinHeight="260">
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn Binding="{Binding Enabled, Mode=TwoWay}" Header="On" Width="55" />
                                                        <DataGridTextColumn Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Zone" Width="170" />
                                                        <DataGridTextColumn Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Header="X" Width="70" />
                                                        <DataGridTextColumn Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Header="Y" Width="70" />
                                                        <DataGridTextColumn Binding="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Header="W" Width="70" />
                                                        <DataGridTextColumn Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Header="H" Width="70" />
                                                        <DataGridTemplateColumn Header="Style" Width="130">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding StyleDisplayName}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding MaskStylesSource, ElementName=SettingsWindow}"
                                                                              DisplayMemberPath="DisplayName"
                                                                              SelectedValue="{Binding Style, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectedValuePath="Value" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellEditingTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Binding="{Binding SurfaceIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Header="Blur %" Width="90" />
                                                        <DataGridCheckBoxColumn Binding="{Binding RevealOnHover, Mode=TwoWay}" Header="Hover reveal" Width="110" />
                                                        <DataGridCheckBoxColumn Binding="{Binding HideDuringTemporaryReveal, Mode=TwoWay}" Header="Hold reveal" Width="105" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                
            </Grid>
        </Border>
                    <ScrollViewer x:Name="ShortcutsPage" Visibility="{Binding IsShortcutsPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Style="{StaticResource PageHeading}" Text="Shortcuts" Margin="0,0,0,24" /><Border Margin="0,0,0,18"
                            Padding="18"
                            Background="#F8F4ED"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Shortcuts" />
                            <TextBlock Margin="0,6,0,14"
                                       Foreground="#51656E"
                                       Text="Enable the shortcuts you use. Unavailable bindings are marked below." />

                            <ItemsControl ItemsSource="{Binding Hotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:HotkeyBindingViewModel}">
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Background="White"
                                                CornerRadius="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#51656E"
                                                               Text="{Binding GestureText}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#A33A2B"
                                                               Text="{Binding RegistrationStatus}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRegistrationFailure}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Enable {0}}"
                                                          AutomationProperties.HelpText="Enable or disable this global shortcut."
                                                          Content="Enabled"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer>
                    <ScrollViewer x:Name="SecurityPage" Visibility="{Binding IsSecurityPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Style="{StaticResource PageHeading}" Text="Security" Margin="0,0,0,24" /><Border Margin="0,12,0,0"
                                    Padding="12"
                                    Background="#ECE4D6"
                                    CornerRadius="16">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Panic unlock PIN" />
                                    <TextBlock Margin="0,6,0,10"
                                               Foreground="#51656E"
                                               TextWrapping="Wrap"
                                               Text="{Binding PanicPinStatus}" />
                                    <Button MinWidth="110"
                                            Padding="10,7"
                                            HorizontalAlignment="Left"
                                            Background="#1F6E6C"
                                            BorderBrush="#1F6E6C"
                                            Foreground="White"
                                            AutomationProperties.HelpText="Add or change the PIN required to disable panic masks."
                                            Click="ConfigurePanicPin_Click"
                                            Content="{Binding PanicPinActionLabel}" />
                                </StackPanel>
                            </Border></StackPanel></ScrollViewer>
                    <ScrollViewer x:Name="SettingsPage" Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Style="{StaticResource PageHeading}" Text="Settings" Margin="0,0,0,24" /><Border Margin="0,0,0,18"
                            Padding="18"
                            Background="#F8F4ED"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="General" />
                            <TextBlock Margin="0,6,0,18"
                                       Foreground="#51656E"
                                       Text="Keep the utility lightweight and predictable." />

                            <CheckBox Content="_Launch when I sign in"
                                      AutomationProperties.HelpText="Starts PrivacyMask automatically for the current Windows user."
                                      IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" />
                            <CheckBox Content="Start _minimized to tray"
                                      AutomationProperties.HelpText="Keeps the settings window hidden when PrivacyMask starts automatically."
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}" />

                            

                            
                        </StackPanel>
                    </Border><TextBlock Text="{Binding ConfigPath}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" /></StackPanel></ScrollViewer>
                    <ScrollViewer x:Name="AboutPage" Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Style="{StaticResource PageHeading}" Text="About PrivacyMask" Margin="0,0,0,24" /><Border Margin="0,0,0,18"
                            Padding="18"
                            Background="#F8F4ED"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="About" />
                            <TextBlock Margin="0,6,0,14"
                                       Foreground="#51656E"
                                       TextWrapping="Wrap"
                                       Text="Read the privacy commitment, app purpose, and direct contact details for the developer." />
                            <Button Width="142"
                                    Padding="12,10"
                                    HorizontalAlignment="Left"
                                    Background="#1F6E6C"
                                    BorderBrush="#1F6E6C"
                                    Click="OpenAbout_Click"
                                    Content="_About PrivacyMask" />
                        </StackPanel>
                    </Border></StackPanel></ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="12" Margin="0,12,0,0" Background="White" CornerRadius="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DiscardButton" Content="Discard" Style="{StaticResource SecondaryButton}" Click="CloseToTray_Click" Margin="0,0,12,0" />
                        <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSave}" Click="Save_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding EditStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

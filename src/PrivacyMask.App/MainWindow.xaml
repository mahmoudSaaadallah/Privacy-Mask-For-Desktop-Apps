<Window
    x:Class="PrivacyMask.App.MainWindow"
    x:Name="SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PrivacyMask.App.ViewModels"
    xmlns:services="clr-namespace:PrivacyMask.App.Services"
    mc:Ignorable="d"
    Title="PrivacyMask"
    Foreground="{StaticResource InkBrush}"
    Icon="pack://application:,,,/PrivacyMask.App;component/Assets/PrivacyMask.ico"
    Width="1460"
    Height="920"
    MinWidth="1180"
    MinHeight="760"
    FontFamily="Segoe UI Variable Text"
    Background="#F2ECE3"
    AutomationProperties.Name="PrivacyMask settings"
    AutomationProperties.HelpText="Configure startup, hotkeys, application profiles, masks, and privacy zones."
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibility" />
        <services:PageSelectionConverter
            x:Key="PageSelection" />
        <Style
            x:Key="NavigationButton"
            TargetType="Button"
            BasedOn="{StaticResource ActionButton}">
            <Setter
                Property="Foreground"
                Value="White" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Left" />
            <Setter
                Property="Margin"
                Value="0,4" />
            <Setter
                Property="MinHeight"
                Value="48" />
            <Style.Triggers>
                <DataTrigger
                    Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding
                            Converter="{StaticResource PageSelection}">
                            <Binding
                                Path="SelectedPage" />
                            <Binding
                                Path="Tag"
                                RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter
                        Property="Background"
                        Value="#245673" />
                    <Setter
                        Property="BorderBrush"
                        Value="#00B6AD" />
                    <Setter
                        Property="BorderThickness"
                        Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    <DataTemplate x:Key="ApplicationDetailTemplate" DataType="{x:Type viewModels:AppProfileViewModel}">
 <StackPanel>
  <DockPanel Margin="0,0,0,20">
   <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,16,0"/>
   <Button DockPanel.Dock="Right" Style="{StaticResource InformationButton}" services:InformationHelp.Text="{Binding ApplicationHelp}" AutomationProperties.Name="Application protection information"/>
   <StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageHeading}"/><TextBlock Text="{Binding RuntimeStatusSummary}" Foreground="{Binding RuntimeStatusColor}" Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel>
  </DockPanel>
  <Border Style="{StaticResource Card}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Profile name" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <DockPanel Grid.Column="1"><CheckBox DockPanel.Dock="Right" Content="Enabled" IsChecked="{Binding Enabled}" Margin="20,0,0,0" VerticalAlignment="Center"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBuiltIn}" MaxLength="80" Padding="10,8" FontSize="16" AutomationProperties.Name="Application profile name"/></DockPanel>
    <TextBlock Grid.Row="1" Text="Blur strength" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,24,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding MaskIntensityPercent,StringFormat={}{0:0}%}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="20,0,0,0"/><Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MaskIntensityPercent}" AutomationProperties.Name="Blur strength" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Grid.Row="2" Text="Mask style" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,24,0,0" Padding="8" FontSize="14" ItemsSource="{Binding MaskStylesSource,ElementName=SettingsWindow}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding PrimaryMaskStyle}" AutomationProperties.Name="Mask style"/>
    <TextBlock Grid.Row="3" Text="Mask color" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,24,0,0" Padding="8" FontSize="14" ItemsSource="{Binding MaskColorsSource,ElementName=SettingsWindow}" SelectedItem="{Binding MaskColor}" AutomationProperties.Name="Mask color"/>
    <TextBlock Grid.Row="4" Text="Activation" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,24,0,0" Padding="8" FontSize="14" ItemsSource="{Binding ActivationModesSource,ElementName=SettingsWindow}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding StartupMode}" AutomationProperties.Name="Activation mode"/>
    <TextBlock Grid.Row="5" Text="Hover reveal" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,24,0,0" Content="Reveal a small region under the pointer" IsChecked="{Binding HoverRevealEnabled}" AutomationProperties.Name="Enable hover reveal"/>
    <TextBlock Grid.Row="6" Text="Reveal size (px)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,24,0,0"/>
    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,24,0,0">
     <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <TextBox Width="100" Padding="8" Text="{Binding HoverRevealWidthPixels,UpdateSourceTrigger=LostFocus}" PreviewTextInput="NumericTextBox_PreviewTextInput" AutomationProperties.Name="Hover reveal width"/>
     <TextBlock Text="Height" VerticalAlignment="Center" Margin="24,0,10,0"/>
     <TextBox Width="100" Padding="8" Text="{Binding HoverRevealHeightPixels,UpdateSourceTrigger=LostFocus}" PreviewTextInput="NumericTextBox_PreviewTextInput" AutomationProperties.Name="Hover reveal height"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border Style="{StaticResource Card}" Margin="0,20,0,0">
   <StackPanel>

    <Expander
                                                        AutomationProperties.Name="Advanced privacy zones"
                                                        AutomationProperties.HelpText="Expand to edit normalized zone coordinates, styles, blur strength, and reveal behavior."
                                                        Header="_Advanced privacy zones">
                                                        <StackPanel
                                                            Margin="0,10,0,0">
<DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Apply preset" Tag="{Binding}" Click="ApplyPreset_Click"/><ComboBox Margin="0,0,16,0" Padding="8" ItemsSource="{Binding Presets}" DisplayMemberPath="DisplayName" SelectedValuePath="PresetId" SelectedValue="{Binding SelectedPresetId}" AutomationProperties.Name="Layout preset"/></DockPanel>
                                                            <TextBlock
                                                                Margin="0,0,0,8"
                                                                Foreground="#51656E"
                                                                TextWrapping="Wrap"
                                                                Text="X, Y, width, and height use 0.00–1.00 coordinates and must stay inside the app. Blur strength supports 0–100%." />
                                                            <DataGrid
                                                                AutoGenerateColumns="False"
                                                                AutomationProperties.Name="Privacy zones"
                                                                AutomationProperties.HelpText="Advanced settings. Edit normalized regions from zero to one and a blur strength from zero to one hundred percent."
                                                                CanUserAddRows="False"
                                                                HeadersVisibility="Column"
                                                                ItemsSource="{Binding Zones}"
                                                                RowBackground="#FCFAF6"
                                                                AlternatingRowBackground="#F7F1E7"
                                                                BorderThickness="0"
                                                                GridLinesVisibility="Horizontal"
                                                                MinHeight="260">
                                                                <DataGrid.Columns>
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding Enabled, Mode=TwoWay}"
                                                                        Header="On"
                                                                        Width="55" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        Header="Zone"
                                                                        Width="170" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="X"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="Y"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="W"
                                                                        Width="70" />
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                        Header="H"
                                                                        Width="70" />
                                                                    <DataGridTemplateColumn
                                                                        Header="Style"
                                                                        Width="130">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock
                                                                                    Text="{Binding StyleDisplayName}" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                                            <DataTemplate>
                                                                                <ComboBox
                                                                                    ItemsSource="{Binding MaskStylesSource, ElementName=SettingsWindow}"
                                                                                    DisplayMemberPath="DisplayName"
                                                                                    SelectedValue="{Binding Style, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                    SelectedValuePath="Value" />
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                                    </DataGridTemplateColumn>
                                                                    <DataGridTextColumn
                                                                        Binding="{Binding SurfaceIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                                                        Header="Blur %"
                                                                        Width="90" />
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding RevealOnHover, Mode=TwoWay}"
                                                                        Header="Hover reveal"
                                                                        Width="110" />
                                                                    <DataGridCheckBoxColumn
                                                                        Binding="{Binding HideDuringTemporaryReveal, Mode=TwoWay}"
                                                                        Header="Hold reveal"
                                                                        Width="105" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Expander>
   </StackPanel>
  </Border>
  <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Visibility="{Binding IsCustom,Converter={StaticResource BooleanToVisibility}}">
   <Button Content="Relink application" Style="{StaticResource SecondaryButton}" Click="RelinkApplication_Click" Tag="{Binding}" Margin="0,0,12,0"/>
   <Button Content="Remove profile" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource DangerBrush}" Click="RemoveApplication_Click" Tag="{Binding}"/>
  </StackPanel>
 </StackPanel>
</DataTemplate>
    </Window.Resources>
    <Grid
        Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="220" />
            <ColumnDefinition
                Width="16" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{StaticResource SidebarBrush}"
            CornerRadius="16"
            Padding="20">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Top"
                    Margin="0,0,0,24">
                    <Image
                        Source="{StaticResource PrivacyMaskLogo}"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        Text="PrivacyMask"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Margin="0,16,0,0" />
                </StackPanel>
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button
                            Content="Overview"
                            Tag="{x:Static viewModels:DesktopPage.Overview}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Content="Applications"
                            Tag="{x:Static viewModels:DesktopPage.Applications}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Content="Shortcuts"
                            Tag="{x:Static viewModels:DesktopPage.Shortcuts}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Content="Security"
                            Tag="{x:Static viewModels:DesktopPage.Security}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Content="Settings"
                            Tag="{x:Static viewModels:DesktopPage.Settings}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Content="About"
                            Tag="{x:Static viewModels:DesktopPage.About}"
                            Style="{StaticResource NavigationButton}"
                            Click="Navigate_Click">
                            <Button.Resources>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="White" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Background="#FCFAF6"
                CornerRadius="16">
                <Grid>
                    <ScrollViewer
                        x:Name="OverviewPage"
                        Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="Overview"
                                Margin="0,0,0,24" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ProtectionHeading}" />
                                    <TextBlock Text="{Binding CurrentModeSummary}" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{StaticResource MutedInkBrush}" />
                                    <WrapPanel>
                                        <Button Content="{Binding GlobalPauseLabel}" IsEnabled="{Binding CanToggleGlobalProtection}" Click="GlobalProtection_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" AutomationProperties.HelpText="Pause or resume global protection. Individual application pauses remain unchanged. Panic cannot be bypassed here." />
                                        <Button Content="{Binding GlobalPanicLabel}" IsEnabled="{Binding CanToggleGlobalPanic}" Click="GlobalPanic_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" AutomationProperties.HelpText="Apply an opaque mask to every protected application, or unlock global panic using your PIN." />
                                    </WrapPanel>
                                    <TextBlock Text="These actions take effect immediately; Save and Discard do not undo them." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,20,0,20">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Protected now" Foreground="{StaticResource MutedInkBrush}"/><TextBlock Text="{Binding ProtectedApplicationCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Enabled profiles" Foreground="{StaticResource MutedInkBrush}"/><TextBlock Text="{Binding EnabledApplicationCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Configured apps" Foreground="{StaticResource MutedInkBrush}"/><TextBlock Text="{Binding ConfiguredApplicationCount}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                            </UniformGrid>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Add application" Click="AddApplication_Click" Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="Your applications" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="No applications configured. Add one to start protecting it." Visibility="{Binding HasNoApplications, Converter={StaticResource BooleanToVisibility}}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding AppProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:AppProfileViewModel}">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RuntimeStatusSummary}" Foreground="{Binding RuntimeStatusColor}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding MaskIntensityPercent, StringFormat={}{0:0}%}" MinWidth="48" TextAlignment="Right"/>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MaskIntensityPercent, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Blur strength for {0}}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Manage" Tag="{Binding}" Click="ManageApplication_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid>
 <Border x:Name="ApplicationsPage" Visibility="{Binding IsApplicationListPage, Converter={StaticResource BooleanToVisibility}}" Padding="24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20">
    <Button DockPanel.Dock="Right" Content="Add application" Click="AddApplication_Click" Style="{StaticResource PrimaryButton}" />
    <TextBlock Text="Applications" Style="{StaticResource PageHeading}" />
   </DockPanel>
   <StackPanel Grid.Row="1" Margin="0,0,0,20">
    <Label Target="{Binding ElementName=ApplicationSearchBox}" Content="_Search applications" Padding="0,0,0,6" />
    <TextBox x:Name="ApplicationSearchBox" Padding="12,10" FontSize="14" AutomationProperties.Name="Search applications" ToolTip="Search by application or process name"
             Text="{Binding ApplicationSearch, UpdateSourceTrigger=PropertyChanged}" />
   </StackPanel>
   <Grid Grid.Row="2">
    <ListBox ItemsSource="{Binding FilteredAppProfiles}" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             AutomationProperties.Name="Configured applications">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:AppProfileViewModel}">
      <Border Style="{StaticResource Card}"><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Image Source="{Binding Icon}" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
       <StackPanel Grid.Column="1" Margin="0,0,16,0">
        <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource InformationButton}" services:InformationHelp.Text="{Binding ApplicationHelp}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Information about {0}}" Margin="8,0,0,0"/><TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{Binding RuntimeStatusSummary}" Foreground="{Binding RuntimeStatusColor}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding MaskIntensitySummary}" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0"/>
<Button Content="Relink" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding NeedsRelink,Converter={StaticResource BooleanToVisibility}}" Click="RelinkApplication_Click" Tag="{Binding}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="Enabled" Margin="0,0,20,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName, StringFormat=Enable {0} masking}"/>
        <Button Content="Manage" Click="ManageApplication_Click" Tag="{Binding}" Style="{StaticResource SecondaryButton}"/>
       </StackPanel>
      </Grid></Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{Binding ApplicationEmptyMessage}" Visibility="{Binding HasNoMatchingApplications, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="16" TextWrapping="Wrap"/>
   </Grid>
  </Grid>
 </Border>
 <ScrollViewer x:Name="ApplicationDetailsPage" Visibility="{Binding IsApplicationDetailsPage, Converter={StaticResource BooleanToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
   <Button Content="← Back to applications" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="BackToApplications_Click" Margin="0,0,0,20"/>
   <ContentControl Content="{Binding SelectedApplication}" ContentTemplate="{StaticResource ApplicationDetailTemplate}" />
  </StackPanel>
 </ScrollViewer>
</Grid>
                    <ScrollViewer
                        x:Name="ShortcutsPage"
                        Visibility="{Binding IsShortcutsPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="Shortcuts"
                                Margin="0,0,0,24" />
                            <Border
                                Margin="0,0,0,18"
                                Padding="18"
                                Background="#F8F4ED"
                                CornerRadius="20">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Shortcuts" />
                                    <TextBlock
                                        Margin="0,6,0,14"
                                        Foreground="#51656E"
                                        Text="Enable the shortcuts you use. Unavailable bindings are marked below." />
                                    <ItemsControl
                                        ItemsSource="{Binding Hotkeys}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                DataType="{x:Type viewModels:HotkeyBindingViewModel}">
                                                <Border
                                                    Margin="0,0,0,10"
                                                    Padding="12"
                                                    Background="White"
                                                    CornerRadius="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition
                                                                Width="*" />
                                                            <ColumnDefinition
                                                                Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Foreground="#51656E"
                                                                Text="{Binding GestureText}" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Foreground="#A33A2B"
                                                                Text="{Binding RegistrationStatus}"
                                                                TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style
                                                                        TargetType="TextBlock">
                                                                        <Setter
                                                                            Property="Visibility"
                                                                            Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding HasRegistrationFailure}"
                                                                                Value="True">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <CheckBox
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Enable {0}}"
                                                            AutomationProperties.HelpText="Enable or disable this global shortcut."
                                                            Content="Enabled"
                                                            IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="SecurityPage"
                        Visibility="{Binding IsSecurityPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="Security"
                                Margin="0,0,0,24" />
                            <Border
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#ECE4D6"
                                CornerRadius="16">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Panic unlock PIN" />
                                    <TextBlock
                                        Margin="0,6,0,10"
                                        Foreground="#51656E"
                                        TextWrapping="Wrap"
                                        Text="{Binding PanicPinStatus}" />
                                    <Button
                                        MinWidth="110"
                                        Padding="10,7"
                                        HorizontalAlignment="Left"
                                        Background="#1F6E6C"
                                        BorderBrush="#1F6E6C"
                                        Foreground="White"
                                        AutomationProperties.HelpText="Add or change the PIN required to disable panic masks."
                                        Click="ConfigurePanicPin_Click"
                                        Content="{Binding PanicPinActionLabel}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="SettingsPage"
                        Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="Settings"
                                Margin="0,0,0,24" />
                            <Border
                                Margin="0,0,0,18"
                                Padding="18"
                                Background="#F8F4ED"
                                CornerRadius="20">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="General" />
                                    <TextBlock
                                        Margin="0,6,0,18"
                                        Foreground="#51656E"
                                        Text="Keep the utility lightweight and predictable." />
                                    <CheckBox
                                        Content="_Launch when I sign in"
                                        AutomationProperties.HelpText="Starts PrivacyMask automatically for the current Windows user."
                                        IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" />
                                    <CheckBox
                                        Content="Start _minimized to tray"
                                        AutomationProperties.HelpText="Keeps the settings window hidden when PrivacyMask starts automatically."
                                        IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Text="{Binding ConfigPath}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="AboutPage"
                        Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="24">
                            <TextBlock
                                Style="{StaticResource PageHeading}"
                                Text="About PrivacyMask"
                                Margin="0,0,0,24" />
                            <Border
                                Margin="0,0,0,18"
                                Padding="18"
                                Background="#F8F4ED"
                                CornerRadius="20">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="About" />
                                    <TextBlock
                                        Margin="0,6,0,14"
                                        Foreground="#51656E"
                                        TextWrapping="Wrap"
                                        Text="Read the privacy commitment, app purpose, and direct contact details for the developer." />
                                    <Button
                                        Width="142"
                                        Padding="12,10"
                                        HorizontalAlignment="Left"
                                        Background="#1F6E6C"
                                        BorderBrush="#1F6E6C"
                                        Click="OpenAbout_Click"
                                        Content="_About PrivacyMask" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Padding="12"
                Margin="0,12,0,0"
                Background="White"
                CornerRadius="12">
                <DockPanel
                    LastChildFill="True">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="DiscardButton"
                            Content="Discard"
                            Style="{StaticResource SecondaryButton}"
                            Click="CloseToTray_Click"
                            Margin="0,0,12,0" />
                        <Button
                            x:Name="SaveButton"
                            Content="Save changes"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanSave}"
                            Click="Save_Click" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding EditStatus}"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedInkBrush}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

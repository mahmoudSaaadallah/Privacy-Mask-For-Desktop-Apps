<Project>
  <PropertyGroup>
    <Authors>Mahmoud Saadallah</Authors>
    <Company>PrivacyMask</Company>
    <Product>PrivacyMask for Desktop Apps</Product>
    <RepositoryUrl>https://github.com/mahmoudSaaadallah/Privacy-Mask-For-Desktop-Apps</RepositoryUrl>
    <Version>2.0.0-beta.8</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.8</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
